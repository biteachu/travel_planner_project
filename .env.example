# Optional account storage. Never put Gemini keys here or in public variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Select a model supported by your Gemini account; verify before deployment.
GEMINI_MODEL=gemini-2.5-flash
# Vercel requires database permits. Apply supabase/rate-limit.sql first.
# Local default is process mode; set database to validate the shared limiter locally.
AGENT_LIMITER_MODE=
# Server-only legacy service_role JWT. NEVER use a NEXT_PUBLIC_ prefix or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=
