# Optional account storage. Never put user Anthropic keys here or in public variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Model ID from Anthropic's official model list. Verify access with your own key.
ANTHROPIC_MODEL=claude-sonnet-5-5
# Vercel requires database permits. Apply supabase/rate-limit.sql first.
# Local default is process mode; set database to validate the shared limiter locally.
AGENT_LIMITER_MODE=
# Server-only legacy service_role JWT. NEVER use a NEXT_PUBLIC_ prefix or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=
# Browser-visible Maps Embed key. Restrict to Embed API and the app's referrers.
GOOGLE_MAPS_EMBED_KEY=
