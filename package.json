{
  "name": "travel-planner-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "video:typecheck": "tsc --project video/tsconfig.json --noEmit",
    "video:studio": "remotion studio video/index.tsx --public-dir=video/public",
    "video:trailer": "remotion render video/index.tsx TrailerDraft video/out/trailer-draft.mp4 --public-dir=video/public --concurrency=2",
    "video:process:preview": "remotion render video/index.tsx ProcessDraft video/out/process-draft.mp4 --public-dir=video/public --concurrency=2",
    "video:check-evidence": "node video/validate-evidence.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@hookform/resolvers": "^7.0.7",
    "@radix-ui/react-dialog": "^1.3.1",
    "@supabase/supabase-js": "^2.119.0",
    "lucide-react": "^1.75.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@playwright/test": "^1.65.1",
    "@remotion/cli": "4.0.545",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.10.1",
    "remotion": "4.0.545",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
